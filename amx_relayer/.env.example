# BSC (source chain — where AmxSale purchases happen)
# Public dataseeds (bsc-dataseed.binance.org etc.) reject eth_getLogs outright — don't use them
# here. See memory: alchemy-bsc-getlogs-cap. bsc-rpc.publicnode.com is documented safe up to
# ~5,000-block getLogs ranges, well above BACKFILL_CHUNK_SIZE's default.
BSC_RPC_URL=https://bsc-rpc.publicnode.com
AMX_SALE_ADDRESS=0x1B44bf0C882de03BEa2c30eCa169fc00F1332759

# Amero X (destination chain — where AmxVault pays out AMX)
AMEROX_RPC_URL=http://91.247.39.40:8545
AMX_VAULT_ADDRESS=0xFfdE9b4AE6C5bC607532b421e2B4C3E73CCaC6b8

# Relayer's own key — must hold EXECUTOR_ROLE on AmxVault and nothing else. Never reuse a key
# that has any other privilege (admin, pauser, or a role on an unrelated contract) — a leaked
# key here should only ever expose the capped, nullifier-protected release() path.
#
# This same key is also used as the gas-payer for sweep() calls on BSC (see auto-sweep config
# below) — that's safe because sweep() is fully permissionless (no role required, fixed
# destination address), so using this key there doesn't grant it any new on-chain privilege.
# Practical consequence: this address needs BOTH AMX (Amero X, for release() gas) AND BNB (BSC,
# for sweep() gas) sitting in it.
RELAYER_PRIVATE_KEY=

# Confirmation depth on BSC before a payout is triggered, tiered by AMX amount.
CONFIRMATIONS_SMALL=15
CONFIRMATIONS_LARGE=45
LARGE_THRESHOLD_AMX_E18=2000000000000000000000

# getLogs backfill chunk size (blocks) and how often to poll for new blocks/pending releases.
BACKFILL_CHUNK_SIZE=2000
POLL_INTERVAL_MS=15000

# Auto-sweep: how often to push AmxSale's accumulated BNB/USDC/USDT to their treasury
# addresses, and the minimum balance worth bothering to sweep (avoids wasting gas sweeping
# dust smaller than the sweep tx itself would cost).
SWEEP_INTERVAL_MS=1800000
MIN_SWEEP_BNB_E18=1000000000000000
MIN_SWEEP_TOKEN_E18=1000000000000000000

# Only read on the very first run (when no scan state exists yet) — the block AmxSale was
# deployed at. REQUIRED for that first run: the relayer refuses to boot without it rather than
# scanning from the current tip, which would silently skip every purchase made before startup.
# Ignored on every subsequent run, once the DB tracks its own progress.
START_BLOCK=128427214

# Relative paths resolve against the amx_relayer package directory, NOT the working directory,
# so this default is stable no matter where the process is launched from. An absolute path
# works too. Point this at the wrong file and you get a new empty database, not an error —
# which reads as "no scan state" and blocks startup (see START_BLOCK above).
DB_PATH=./relayer.sqlite
